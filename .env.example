# Copy to .env. Supply a random local password; never commit .env.
POSTGRES_USER=dinequeue
POSTGRES_DB=dinequeue
POSTGRES_PASSWORD=
# Compose connects API to the internal db service using the values above.
APP_ENV=development
APP_ORIGIN=http://localhost:3000
# Used for running API directly on the host. Local Compose does not publish DB.
DATABASE_URL=
PORT=8080
# Host web process only; Compose overrides this with http://api:8080.
API_INTERNAL_URL=http://127.0.0.1:8080
NEXT_TELEMETRY_DISABLED=1
