    "/api/v1/queues/{queueId}/entries": {
      "post": {
        "summary": "Join an active waitlist",
        "description": "CUSTOMER only. Atomically allocate local-date sequence and persist WAITING. 409 ACTIVE_QUEUE_EXISTS or QUEUE_INACTIVE. Numbers/status/date/owner are assigned by the server.",
