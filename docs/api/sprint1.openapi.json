    "/api/v1/host/queues/{queueId}/entries/{entryId}/complete": {
      "post": {
        "summary": "Complete the selected CALLED ticket",
        "description": "Assigned HOST only, no request body. Scope entry to path queue. Only CALLED -> COMPLETED; otherwise 409 INVALID_TRANSITION. Records actor/time/version atomically. S1 manual waitlist completion, not table allocation.",
        "x-requirement-ids": [
          "FR-008",
          "FR-009",
          "BR-004",
          "BR-006"
        ],
        "responses": {
          "200": {
            "description": "Success",
