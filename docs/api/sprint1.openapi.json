          "FR-003",
          "FR-004",
          "FR-009",
          "FR-023",
          "BR-001",
          "BR-002",
          "BR-008",
          "BR-009"
        ],
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Entry"
                }
              }
