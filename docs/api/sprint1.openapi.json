{
  "openapi": "3.1.0",
  "info": {
    "title": "DineQueue Sprint 1 API",
    "version": "2.0-sprint1",
    "description": "Implemented S1 only. Private responses are Cache-Control: no-store. Error responses never expose DB details. Explicit SQL migrations and seeded accounts are configured separately. HTTP local port may be 8081 with the developer override; public browser traffic normally uses Next.js same-origin rewrites."
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Default local API"
    }
  ],
  "security": [
    {
      "localSession": []
    },
    {
      "secureSession": []
    }
  ],
  "paths": {
    "/health/live": {
      "get": {
        "summary": "Process liveness",
        "description": "",
        "x-requirement-ids": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Live"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/health/ready": {
      "get": {
        "summary": "Database readiness",
        "description": "",
        "x-requirement-ids": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ready"
                }
              }
            }
          },
          "503": {
            "description": "Database unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Unavailable"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "summary": "Authenticate seeded Customer or Host",
        "description": "Body <=4 KiB. Generic invalid/disabled-account response. Successful login rotates the presented session and creates a DB-backed opaque session for 12 hours.",
        "x-requirement-ids": [
          "FR-001",
          "NFR-004"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            },
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                },
                "description": "HttpOnly; Path=/; SameSite=Lax. Secure __Host-dineq_session under HTTPS; dineq_session for HTTP development."
              }
            }
          },
          "400": {
            "description": "VALIDATION_ERROR",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHENTICATED or INVALID_CREDENTIALS",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "FORBIDDEN or CSRF_REJECTED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "RATE_LIMITED; inspect Retry-After",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "string"
                },
                "description": "Delta-seconds before retry."
              }
            }
          },
          "500": {
            "description": "Generic INTERNAL_ERROR",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [],
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "description": "Must exactly equal configured APP_ORIGIN.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        }
      }
    },
