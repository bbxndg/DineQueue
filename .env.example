# Copy to .env. Supply a random local password; never commit .env.
# Local Compose PostgreSQL role and database.
POSTGRES_USER=dinequeue
POSTGRES_DB=dinequeue
# Local PostgreSQL password; use the same password in DATABASE_URL.
POSTGRES_PASSWORD=
# Compose passes DATABASE_URL below; set its host to db and match credentials above.
# Go API runtime configuration.
APP_ENV=development
# Exact browser origin accepted by auth/CSRF checks; use HTTPS in production.
APP_ORIGIN=http://localhost:3000
# PostgreSQL URL passed to the API. For Compose, use hostname db.
# For a host-run API, use a database address reachable from the host.
DATABASE_URL=
# Go HTTP listener port inside the API process/container.
PORT=8080
# Server-only Next.js API origin; Compose overrides this with http://api:8080.
API_INTERNAL_URL=http://127.0.0.1:8080
# Disable Next.js telemetry in local/dev containers.
NEXT_TELEMETRY_DISABLED=1
# Opt-in demo seed only (12–128 bytes each). No default demo credentials.
SEED_CUSTOMER_PASSWORD=
SEED_CUSTOMER2_PASSWORD=
SEED_HOST_PASSWORD=
SEED_OTHER_HOST_PASSWORD=

# Optional compose.production.yaml local verification ports (separate from dev).
# Browser origin is http://localhost:WEB_HOST_PORT; API upstream uses PORT above.
WEB_HOST_PORT=3002
API_HOST_PORT=8082
WEB_PORT=3000
